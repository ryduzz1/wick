{
  "name": "wick",
  "version": "0.1.0",
  "description": "Screen-aware Roblox macros that react in real time, loop on their own, and can be written by AI agents.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "app/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:engine": "node scripts/build-engine.mjs",
    "start": "node scripts/build-engine.mjs && electron .",
    "test": "node scripts/build-engine.mjs && node --no-warnings --test \"tests/*.test.js\"",
    "test:engine": "cargo test --manifest-path engine/Cargo.toml",
    "smoke:app": "node scripts/build-engine.mjs && node scripts/smoke-app.mjs",
    "check": "node scripts/check.mjs",
    "wick": "node bin/wick.js",
    "dist:dir": "node scripts/dist.mjs --dir",
    "dist": "node scripts/dist.mjs",
    "smoke:dist": "node scripts/smoke-dist.mjs"
  },
  "devDependencies": {
    "electron": "44.10.0",
    "electron-builder": "26.17.0"
  },
  "bin": {
    "wick": "bin/wick.js"
  },
  "build": {
    "appId": "io.github.ryduzz1.wick",
    "productName": "Wick",
    "copyright": "Copyright \u00a9 2026 ryder",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**",
      "bin/**",
      "sdk/**",
      "testbench/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "examples",
        "to": "examples",
        "filter": [
          "**/*",
          "!**/.wick/**",
          "!**/node_modules/**"
        ]
      }
    ],
    "asar": true,
    "protocols": [
      {
        "name": "Wick macro link",
        "schemes": [
          "wick"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "wick",
        "name": "Wick macro",
        "description": "Wick macro",
        "role": "Viewer",
        "mimeType": "application/x-wick-macro"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "app/ui/assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "extendInfo": {
        "NSScreenCaptureUsageDescription": "Wick watches the game window so macros can react to what's on screen."
      },
      "extraResources": [
        {
          "from": "engine/target/release/wick-engine",
          "to": "wick-engine"
        },
        {
          "from": "build/cli/wick",
          "to": "bin/wick"
        }
      ]
    },
    "win": {
      "icon": "app/ui/assets/icon.png",
      "target": [
        "nsis",
        "zip"
      ],
      "extraResources": [
        {
          "from": "engine/target/release/wick-engine.exe",
          "to": "wick-engine.exe"
        },
        {
          "from": "build/cli/wick.cmd",
          "to": "bin/wick.cmd"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ryduzz1",
        "repo": "wick",
        "releaseType": "draft"
      }
    ]
  },
  "author": "ryder"
}
